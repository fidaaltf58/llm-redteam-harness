# Copy to .env (never commit it) or export these in your shell.

# Ollama (default target). Only change if Ollama is not on localhost.
OLLAMA_HOST=http://localhost:11434

# OpenAI-compatible target (OpenAI, Groq, Together, vLLM, LM Studio, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Demo vulnerable RAG app
DEMO_APP_URL=http://127.0.0.1:8000
DEMO_LLM_BACKEND=ollama   # ollama | mock
DEMO_OLLAMA_MODEL=llama3.1:8b
